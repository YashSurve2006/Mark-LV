# ── MARK LV — .gitignore ───────────────────────────────────────────────────
# Everything listed here is created at runtime and must never be committed.

# ── Secrets & Credentials (NEVER commit these) ──────────────────────────────
config/api_keys.json
config/certs/
config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
*.pem
*.key
*.crt
.env
.env.*

# ── Personal data & memory ──────────────────────────────────────────────────
memory/long_term.json
memory/notes/
memory/*.db
memory/*.sqlite
memory/*.sqlite3

# ── Python build & cache ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── IDEs and OS files ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime logs and media dumps ────────────────────────────────────────────
*.log
logs/
downloads/
screenshots/
temp/
tmp/
output/
config/linkedin_session/

